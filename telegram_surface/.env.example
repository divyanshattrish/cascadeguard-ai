# CascadeGuard AI - Telegram Surface Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit the real .env or *.session files to GitHub!

# 1. Telegram Bot Gateway Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram MTProto Client API (from https://my.telegram.org/apps)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
