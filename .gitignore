# =============================================================================
# CascadeGuard AI — Git Ignore Configuration
# Protects secrets, credentials, binary sessions, and ephemeral caches
# =============================================================================

# 1. Critical Credentials & Secrets (NEVER COMMIT!)
.env
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.session
*.session-journal
telegram_surface/*.session
telegram_surface/*.session-journal
telegram_surface/.env

# 2. Node.js & Web Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
build/
.cache/

# 3. Python Bytecode, Caches & Virtual Envs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/

# 4. IDE, OS & System Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.log
.agents/
